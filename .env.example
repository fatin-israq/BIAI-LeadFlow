# BIAI LeadFlow Environment Configuration Template

# -------------------------------------------------------------
# Frontend Client Variables (Vite Prefixed)
# -------------------------------------------------------------
# Set to 'true' to run fully offline with sample data and local storage
VITE_DEMO_MODE=true

# Supabase Public API (Leave empty when running in Demo Mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -------------------------------------------------------------
# Server-Side / Cloudflare Pages Functions Variables
# (Secure - Do NOT expose to client code or Git)
# -------------------------------------------------------------
# Supabase Backend Credentials
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# n8n Automation Webhook
N8N_WEBHOOK_URL=
N8N_SHARED_SECRET=

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
